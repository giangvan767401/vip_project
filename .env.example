# ==============================================================================
# MindLog Environment Configuration Template
# ==============================================================================

# ── Database (MySQL) ──
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mindlog
DB_USER=mindlog_user
DB_PASSWORD=mindlog_secret
DB_ROOT_PASSWORD=root_password
DATABASE_URL="mysql://mindlog_user:mindlog_secret@localhost:3306/mindlog"

# ── AI Service (FastAPI) ──
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Backend API (NestJS) ──
PORT=3001
JWT_SECRET=super_secret_mindlog_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
