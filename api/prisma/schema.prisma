generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  COUNSELOR
  ADMIN
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  password       String
  fullName       String
  role           Role           @default(USER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  emotionLogs    EmotionLog[]
  journalEntries JournalEntry[]

  @@map("users")
}

model EmotionLog {
  id            String    @id @default(cuid())
  userId        String
  emotion       String
  positiveScore Float     @default(0)
  negativeScore Float     @default(0)
  scores        Json?
  startedAt     DateTime  @default(now())
  endedAt       DateTime  @default(now())
  note          String?   @db.Text
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("emotion_logs")
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  mood      Int      // 1 to 5
  note      String   @db.Text
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@map("journal_entries")
}

model AlertRule {
  id                String   @id @default(cuid())
  name              String
  negativeThreshold Float    @default(50.0)
  consecutiveDays   Int      @default(4)
  timeWindowDays    Int      @default(7)
  level             String   @default("vua") // nhe, vua, keo_dai
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("alert_rules")
}

model Resource {
  id              String   @id @default(cuid())
  title           String
  description     String?  @db.Text
  type            String   // EXERCISE, ARTICLE, HOTLINE, TIP
  level           String   @default("all") // all, nhe, vua, keo_dai
  content         String?  @db.Text
  url             String?
  durationMinutes Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("resources")
}

