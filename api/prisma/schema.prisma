generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  COUNSELOR
  ADMIN
}

enum ConsentStatus {
  ACTIVE
  REVOKED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id                    String         @id @default(cuid())
  email                 String         @unique
  password              String
  fullName              String
  role                  Role           @default(USER)
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  emotionLogs           EmotionLog[]
  journalEntries        JournalEntry[]
  consentsGiven         ConsentShare[] @relation("UserConsents")
  consentsReceived      ConsentShare[] @relation("CounselorConsents")
  appointmentsStudent   Appointment[]  @relation("StudentAppointments")
  appointmentsCounselor Appointment[]  @relation("CounselorAppointments")
  resourcesCreated      Resource[]     @relation("CreatedResources")
  conversationsStudent  Conversation[] @relation("UserConversations")
  conversationsCounselor Conversation[] @relation("CounselorConversations")
  messagesSent          Message[]      @relation("SentMessages")

  @@map("users")
}

model EmotionLog {
  id            String    @id @default(cuid())
  userId        String
  emotion       String
  positiveScore Float     @default(0)
  negativeScore Float     @default(0)
  scores        Json?
  startedAt     DateTime  @default(now())
  endedAt       DateTime  @default(now())
  note          String?   @db.Text
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("emotion_logs")
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  mood      Int      // 1 to 5
  note      String   @db.Text
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@map("journal_entries")
}

model AlertRule {
  id                String   @id @default(cuid())
  name              String
  negativeThreshold Float    @default(50.0)
  consecutiveDays   Int      @default(4)
  timeWindowDays    Int      @default(7)
  level             String   @default("vua") // nhe, vua, keo_dai
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("alert_rules")
}

model Resource {
  id              String   @id @default(cuid())
  creatorId       String?
  title           String
  description     String?  @db.Text
  type            String   // EXERCISE, ARTICLE, HOTLINE, TIP
  level           String   @default("all") // all, nhe, vua, keo_dai
  content         String?  @db.Text
  url             String?
  durationMinutes Int?
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  creator User? @relation("CreatedResources", fields: [creatorId], references: [id], onDelete: SetNull)

  @@index([creatorId])
  @@index([level])
  @@map("resources")
}

model ConsentShare {
  id          String        @id @default(cuid())
  userId      String
  counselorId String
  status      ConsentStatus @default(ACTIVE)
  grantedAt   DateTime      @default(now())
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user      User @relation("UserConsents", fields: [userId], references: [id], onDelete: Cascade)
  counselor User @relation("CounselorConsents", fields: [counselorId], references: [id], onDelete: Cascade)

  @@unique([userId, counselorId])
  @@index([userId])
  @@index([counselorId])
  @@index([status])
  @@map("consent_shares")
}

model Appointment {
  id          String            @id @default(cuid())
  userId      String
  counselorId String
  startAt     DateTime
  note        String?           @db.Text
  status      AppointmentStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user      User @relation("StudentAppointments", fields: [userId], references: [id], onDelete: Cascade)
  counselor User @relation("CounselorAppointments", fields: [counselorId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([counselorId])
  @@index([startAt])
  @@index([status])
  @@map("appointments")
}

enum ConversationStatus {
  PENDING
  ACTIVE
  CLOSED
}

model Conversation {
  id          String             @id @default(cuid())
  userId      String
  counselorId String
  status      ConversationStatus @default(PENDING)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user      User      @relation("UserConversations", fields: [userId], references: [id], onDelete: Cascade)
  counselor User      @relation("CounselorConversations", fields: [counselorId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
  @@index([counselorId])
  @@index([status])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String       @db.Text
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}


